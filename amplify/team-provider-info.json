      "AuthRoleName": "amplify-panoramaviewer-dev-authRole",
      "UnauthRoleName": "amplify-panoramaviewer-dev-unauthRole",
      "AuthRoleArn": "arn:aws:iam::ACCOUNT-ID:role/amplify-panoramaviewer-dev-authRole",
      "UnauthRoleArn": "arn:aws:iam::ACCOUNT-ID:role/amplify-panoramaviewer-dev-unauthRole",
      "DeploymentBucketName": "amplify-panoramaviewer-dev-deployment",
